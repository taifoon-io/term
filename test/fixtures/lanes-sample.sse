data: {"who":"address","unit":"grade","grades":{"free":{"per_user":3,"used":1,"left":2},"bought":{"left":0,"blocks":0},"per_block":3,"per_minute":5},"free":{"calls":3,"used":1,"left":2},"credits":{"left":0,"blocks":0},"burst":{"per_minute":5,"used_this_minute":0},"anon_today":{"cap":150,"used":52},"price":{"grid_per_grade":5,"grid_per_call":5,"grades_per_block":3,"grid_per_block":15,"grid_usdc":0.01,"usdc_per_block":0.15,"peg_source":"oracle"},"buy":"sign in or send an X-API-Key; then top up the balance (GET /v1/access/quote?usdc=1&chainId=8453): one balance pays grades, records and calls","gpu":{"usdc_per_block":1,"lanes":["nemotron/chat","auditor/generate","wizard/chat","studio/chat"],"purchases":[],"usdc_bought":"0.000000","balance":"GET https://api.taifoon.dev/gpu/credits with the same X-API-Key (the gate debits per call; only Base purchases count there)","buy":"POST /v1/judge/credits { product: \"gpu\", blocks, chainId: 8453 } → send the transfer → sign creditMessage(credit_to, 8453, tx, \"gpu\") → POST /v1/judge/credits/confirm { tx, chainId: 8453, signature, product: \"gpu\" }; no key yet: GET /v1/judge/credits/key?product=gpu"},"deprecated":"free.calls / credits / price.grid_per_call are the old names of grades.free.per_user / grades.bought / price.grid_per_grade; they go in the next release. A grade is Taifoon's composed grade (facts + answers + verdict + record); purchases made as calls count one for one.","lane":"quota","ts":1792171599445}

