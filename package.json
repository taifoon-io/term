{
  "name": "@taifoon/term",
  "version": "0.3.0",
  "description": "The step renderer shared by `taifoon up` and `jev run`: \u2192 \u25cf \u23bf \u2713 ! \u2717 lines, elapsed ms, a spinner, NO_COLOR and non-TTY aware. Plus the live stream view (`@taifoon/term/stream`) shared by `taifoon stream` and `taifoon-sdk coord stream`. ESM, no dependencies, no import-time side effects.",
  "license": "MIT",
  "author": {
    "name": "Taifoon",
    "email": "yawning.monsoon@proton.me",
    "url": "https://github.com/taifoon-io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/term.git"
  },
  "type": "module",
  "main": "./term.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./term.mjs"
    },
    "./stream": {
      "types": "./stream.d.ts",
      "import": "./stream.mjs"
    },
    "./measures": {
      "types": "./measures.d.ts",
      "import": "./measures.mjs"
    }
  },
  "files": [
    "term.mjs",
    "stream.mjs",
    "measures.mjs",
    "index.d.ts",
    "stream.d.ts",
    "measures.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/term.test.mjs test/stream.test.mjs test/measures.test.mjs"
  }
}
